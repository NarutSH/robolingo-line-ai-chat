# Copy to .env.local. For local development, run `bunx supabase start` and use
# the keys it prints — they are the CLI's fixed demo keys, the same everywhere.
# Production values belong in the Vercel dashboard, never in a committed file.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Publishable key ships to the browser by design; it is used only to subscribe
# to Realtime broadcast. The browser never reads database rows.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Every database read and write goes through this key.
SUPABASE_SECRET_KEY=sb_secret_...

# ── LINE Messaging API ───────────────────────────────────────────────────────
# LINE Developers Console → your Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── AI ───────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# How long the agent waits for the customer to finish typing before it answers,
# so a question sent across two or three messages gets one reply instead of
# three. 0 disables the wait. Default 4000.
AI_DEBOUNCE_MS=4000

# ── Operator console ─────────────────────────────────────────────────────────
OPERATOR_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
